              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"idMatriculaPrueba\",pm.response.json().id);"
                ]
              }
            }
          ]
        }
