                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"estudianteId\": \"{{idEstudiante1}}\", \"cursoId\": \"{{idCursoPrueba}}\"}",
              "options": {
