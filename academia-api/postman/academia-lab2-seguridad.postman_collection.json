                  "const r=pm.response.json().contenido;pm.collectionVariables.set(\"idEstudiante1\",r.find(e=>e.codigo===\"N00123456\").id);pm.collectionVariables.set(\"idEstudiante2\",r.find(e=>e.codigo===\"N00987654\").id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ocupar la única plaza",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/matriculas",
            "header": [
