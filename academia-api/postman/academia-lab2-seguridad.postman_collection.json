                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p=pm.collectionVariables.get(\"tokenAdmin\").split(\".\");p[2]=(p[2][0]===\"A\"?\"B\":\"A\")+p[2].slice(1);pm.variables.set(\"tokenAlterado\",p.join(\".\"));"
                ]
              }
            },
