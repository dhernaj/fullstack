                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"clave-incorrecta-de-prueba\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));",
                  "pm.test(\"Mensaje genérico\",()=>pm.expect(pm.response.json().detail).to.eql(\"Usuario o contraseña incorrectos\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Lectura como estudiante",
      "item": [
        {
          "name": "Listar y ordenar cursos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cursos?size=3&sort=creditos,desc",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Página de tres y SIS-310 primero\",()=>{const r=pm.response.json();pm.expect(r.contenido.length).to.eql(3);pm.expect(r.contenido[0].codigo).to.eql(\"SIS-310\");pm.collectionVariables.set(\"idCursoConMatriculas\",r.contenido.find(c=>c.codigo===\"SIS-101\").id);});"
                ]
              }
            }
          ]
        }
      ]
    },
