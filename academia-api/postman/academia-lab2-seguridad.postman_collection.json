{
  "info": {
    "name": "Academia UPN – Laboratorio 2 – Seguridad",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Doce casos de la parte E con preparación y comprobaciones adicionales. Completar contraseñas locales antes de importar/ejecutar. Se ejecuta en H2 recién iniciado con los datos demo; no repetir contra PostgreSQL sin adaptar códigos y preparación."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080/api/v1"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "docentePassword",
      "value": ""
    },
    {
      "key": "estudiantePassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Preparación de tokens",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Token Bearer\",()=>{const r=pm.response.json();pm.expect(r.tokenType).to.eql(\"Bearer\");pm.expect(r.roles).to.include(\"ADMIN\");pm.collectionVariables.set(\"tokenAdmin\",r.accessToken);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Docente",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"docente\", \"password\": \"{{docentePassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Token Bearer\",()=>{const r=pm.response.json();pm.expect(r.tokenType).to.eql(\"Bearer\");pm.expect(r.roles).to.include(\"DOCENTE\");pm.collectionVariables.set(\"tokenDocente\",r.accessToken);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Estudiante",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"estudiante\", \"password\": \"{{estudiantePassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Token Bearer\",()=>{const r=pm.response.json();pm.expect(r.tokenType).to.eql(\"Bearer\");pm.expect(r.roles).to.include(\"ESTUDIANTE\");pm.collectionVariables.set(\"tokenEstudiante\",r.accessToken);});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Sin token",
      "item": [
        {
          "name": "Listar sin autenticación",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cursos",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));",
                  "pm.test(\"Challenge Bearer\",()=>pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Login incorrecto",
      "item": [
        {
          "name": "Rechazar contraseña incorrecta",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
