  "item": [
    {
      "name": "01 - Crear curso válido",
      "item": [
        {
          "name": "Crear curso válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cursos",
            "body": {
              "mode": "raw",
              "raw": "{\"codigo\": \"{{codigoPrincipal}}\", \"nombre\": \"Arquitectura de Software\", \"creditos\": 4, \"docente\": \"José Canchucaja\", \"cupos\": 25}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"idPrincipal\", pm.response.json().id);",
                  "pm.test(\"Location e identificador generado\", () => { const c=pm.response.json(); pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/cursos/\"+c.id+\"$\")); pm.expect(c.activo).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
