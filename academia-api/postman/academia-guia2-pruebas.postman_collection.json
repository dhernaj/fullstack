                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Problem Details sin trazas\", () => { const p = pm.response.json(); pm.expect(p.status).to.eql(pm.response.code); pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); pm.expect(p).to.not.have.property(\"trace\"); pm.expect(p).to.not.have.property(\"exception\"); });"
