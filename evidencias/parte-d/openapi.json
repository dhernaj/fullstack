        ],
        "operationId": "retirar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MatriculaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cursos/{id}/cupos": {
      "patch": {
        "tags": [
          "Cursos"
        ],
        "summary": "Actualizar los cupos de un curso",
        "description": "Requiere rol ADMIN",
        "operationId": "actualizarCupos",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CuposRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CursoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/estudiantes/{id}": {
      "get": {
        "tags": [
          "Estudiantes"
        ],
        "operationId": "obtener_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EstudianteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/estudiantes/{id}/matriculas": {
      "get": {
        "tags": [
          "Estudiantes"
        ],
        "operationId": "matriculas",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatriculaResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cursos/{id}/matriculas": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Consultar matrículas de un curso",
        "description": "Requiere ADMIN o DOCENTE",
        "operationId": "matriculas_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatriculaResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cursos/resumen": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Consultar la ocupación de los cursos",
        "description": "Cuenta solo matrículas activas; requiere ADMIN o DOCENTE",
        "operationId": "resumen",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CursoResumen"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CursoRequest": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z]{3}-\\d{3}$"
          },
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "creditos": {
            "type": "integer",
            "format": "int32",
            "maximum": 6,
            "minimum": 1
          },
          "docente": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "cupos": {
            "type": "integer",
            "format": "int32",
            "maximum": 60,
            "minimum": 1
          }
        },
        "required": [
          "codigo",
          "docente",
          "nombre"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "MatriculaRequest": {
        "type": "object",
        "properties": {
          "estudianteId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          },
          "cursoId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "cursoId",
          "estudianteId"
        ]
      },
      "MatriculaResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "estudianteId": {
            "type": "integer",
            "format": "int64"
          },
          "estudianteNombre": {
            "type": "string"
          },
          "cursoId": {
            "type": "integer",
            "format": "int64"
          },
          "cursoNombre": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "estado": {
            "type": "string",
            "enum": [
              "ACTIVA",
              "RETIRADA"
            ]
          }
        }
      },
      "EstudianteRequest": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "maxLength": 10,
            "minLength": 0
          },
          "nombres": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "apellidos": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 120,
            "minLength": 0
          }
        },
        "required": [
          "apellidos",
          "codigo",
          "email",
          "nombres"
        ]
      },
      "EstudianteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "codigo": {
            "type": "string"
          },
          "nombres": {
            "type": "string"
          },
          "apellidos": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "CursoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "codigo": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "creditos": {
            "type": "integer",
            "format": "int32"
          },
          "docente": {
            "type": "string"
          },
          "cupos": {
            "type": "integer",
            "format": "int32"
          },
          "activo": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CuposRequest": {
        "type": "object",
        "properties": {
          "cupos": {
            "type": "integer",
            "format": "int32",
            "maximum": 60,
            "minimum": 1
          }
        }
      },
      "PaginaResponseEstudianteResponse": {
        "type": "object",
        "properties": {
          "contenido": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EstudianteResponse"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamanio": {
            "type": "integer",
            "format": "int32"
          },
          "totalElementos": {
            "type": "integer",
            "format": "int64"
          },
          "totalPaginas": {
            "type": "integer",
            "format": "int32"
          },
          "ultima": {
            "type": "boolean"
          }
        }
      },
      "PaginaResponseCursoResponse": {
        "type": "object",
        "properties": {
          "contenido": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CursoResponse"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamanio": {
            "type": "integer",
            "format": "int32"
          },
          "totalElementos": {
            "type": "integer",
            "format": "int64"
          },
          "totalPaginas": {
            "type": "integer",
            "format": "int32"
          },
          "ultima": {
            "type": "boolean"
          }
        }
      },
      "CursoResumen": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "codigo": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "cupos": {
            "type": "integer",
            "format": "int32"
          },
          "matriculados": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
