{
  "openapi": "3.1.0",
  "info": {
    "title": "Academia UPN API",
    "description": "Gestión de cursos, estudiantes y matrículas con autenticación JWT.",
    "contact": {
      "name": "Academia UPN"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8083",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Matrículas",
      "description": "Inscripción y retiro de matrículas"
    },
    {
      "name": "Estudiantes",
      "description": "Registro de estudiantes y consulta de sus matrículas"
    },
    {
      "name": "Cursos",
      "description": "Catálogo de cursos"
    },
    {
      "name": "Autenticación",
      "description": "Inicio de sesión y emisión de JWT"
    }
  ],
  "paths": {
    "/api/v1/cursos/{id}": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Obtener un curso por id",
        "operationId": "obtener",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Curso encontrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CursoResponse"
                }
              }
            }
          },
          "404": {
            "description": "El curso no existe",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Cursos"
        ],
        "summary": "Actualizar un curso",
        "description": "Requiere rol ADMIN",
        "operationId": "actualizar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CursoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "El curso no existe",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Código duplicado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Cursos"
        ],
        "summary": "Desactivar un curso",
        "description": "Eliminación lógica. Requiere rol ADMIN; no admite cursos con matrículas.",
        "operationId": "eliminar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Curso desactivado, sin contenido"
          },
          "404": {
            "description": "El curso no existe",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "El curso tiene matrículas",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matriculas": {
      "post": {
        "tags": [
          "Matrículas"
        ],
        "operationId": "crear",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatriculaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MatriculaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/estudiantes": {
      "get": {
        "tags": [
          "Estudiantes"
        ],
        "operationId": "listar",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page index (0..N)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "The size of the page to be returned",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
            "required": false,
            "schema": {
              "type": "array",
              "default": [
                "apellidos,ASC"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaResponseEstudianteResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Estudiantes"
        ],
        "operationId": "crear_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstudianteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EstudianteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cursos": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Listar cursos paginados",
        "description": "Filtros opcionales por docente y créditos mínimos. El tamaño de página se limita a 50.",
        "operationId": "listar_1",
        "parameters": [
          {
            "name": "docente",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "creditosMin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page index (0..N)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "The size of the page to be returned",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
            "required": false,
            "schema": {
              "type": "array",
              "default": [
                "id,ASC"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaResponseCursoResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Cursos"
        ],
        "summary": "Crear un curso",
        "description": "Requiere rol ADMIN",
        "operationId": "crear_2",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CursoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Curso creado; cabecera Location",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CursoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Código duplicado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión",
        "description": "Devuelve accessToken, tokenType, expiresIn, username y roles",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/matriculas/{id}/retiro": {
      "patch": {
        "tags": [
